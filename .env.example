# Customer email sign-in (Node development/preview server only).
APP_URL="http://localhost:3000"
MAIL_FROM="no-reply@example.com"
# Keep SMTP credentials in an untracked .env file, never in this template.
SMTP_URL=""
# Optional Node preview bootstrap account; set all identity values in an untracked .env.
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PHONE=""

# Private provider configuration: never commit real values or expose secrets in the client.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
# Approved template names and language codes are private config; leave empty until supplied.
# Expected keys: manual, newsletter, new_enquiry, quote_status, invoice_status, ticket_status, installation_status.
WHATSAPP_TEMPLATES_JSON="{}"
VAPID_SUBJECT="mailto:admin@example.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
